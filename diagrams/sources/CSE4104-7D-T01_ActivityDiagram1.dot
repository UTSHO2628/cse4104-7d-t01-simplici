digraph A {
graph [rankdir=TB, nodesep=0.5, ranksep=0.42, pad=0.4, splines=true, fontname="Helvetica", labelloc=t, labeljust=l, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="LEFT"><FONT COLOR="#0B3D91" POINT-SIZE="20"><B>Activity Diagram 1: Upload and Simplify a Document</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">Workflow of the main feature of SimpliCI, from the user's upload to the simplified result (SRS UC-03, UC-04, UC-05; API-08, API-14, API-16).</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">Legend: blue = user action, grey = system process, violet = AI service step, green = output shown to the user, yellow diamond = decision, black circle = start, double circle = end.</FONT></TD></TR></TABLE>>];
node [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", margin="0.16,0.08"];
edge [fontname="Helvetica-Oblique", fontsize=9, color="#374151", arrowsize=0.8];
start [shape=circle, label="", width=0.25, style=filled, fillcolor="#111827", color="#111827"];
end [shape=doublecircle, label="", width=0.22, style=filled, fillcolor="#111827", color="#111827"];
u1 [fillcolor="#E8F0FE", color="#0B3D91", label="Upload a PDF or image, or paste text,\nand choose the domain"];
s1 [fillcolor="#F3F4F6", color="#6B7280", label="Validate file type, size and page count"];
d1 [shape=diamond, style=filled, fillcolor="#FFF4D6", color="#B45309", label="Input\nvalid?", margin="0.04,0.02"];
o1 [fillcolor="#E7F6EC", color="#15803D", label="Show a clear error message"];
s2 [fillcolor="#F3F4F6", color="#6B7280", label="Save the file in private storage\nand create the document record"];
u2 [fillcolor="#E8F0FE", color="#0B3D91", label="Choose language and reading level,\nthen press Simplify"];
s3 [fillcolor="#F3F4F6", color="#6B7280", label="Check the AI rate limit and stored results"];
d2 [shape=diamond, style=filled, fillcolor="#FFF4D6", color="#B45309", label="Same settings\nalready processed?", margin="0.04,0.02"];
s4 [fillcolor="#F3F4F6", color="#6B7280", label="Return the stored result (cache)"];
d3 [shape=diamond, style=filled, fillcolor="#FFF4D6", color="#B45309", label="Rate limit\nreached?", margin="0.04,0.02"];
o2 [fillcolor="#E7F6EC", color="#15803D", label="Show 'try again later' message (429)"];
s5 [fillcolor="#F3F4F6", color="#6B7280", label="Extract text page by page"];
d4 [shape=diamond, style=filled, fillcolor="#FFF4D6", color="#B45309", label="Page has\nusable text?", margin="0.04,0.02"];
a1 [fillcolor="#EDE9FE", color="#6D28D9", label="Read the page with the Gemini vision model"];
s6 [fillcolor="#F3F4F6", color="#6B7280", label="Build the domain prompt\n(preset, language, level, JSON schema)"];
a2 [fillcolor="#EDE9FE", color="#6D28D9", label="Gemini returns structured JSON"];
d5 [shape=diamond, style=filled, fillcolor="#FFF4D6", color="#B45309", label="JSON\nvalid?", margin="0.04,0.02"];
d6 [shape=diamond, style=filled, fillcolor="#FFF4D6", color="#B45309", label="Retry\nalready used?", margin="0.04,0.02"];
o3 [fillcolor="#E7F6EC", color="#15803D", label="Show a friendly error (status failed)"];
s7 [fillcolor="#F3F4F6", color="#6B7280", label="Save the result with model name,\nprompt version, tokens and time"];
o4 [fillcolor="#E7F6EC", color="#15803D", label="Show summary, explanation, glossary,\naction items and Smart Alerts"];
u3 [fillcolor="#E8F0FE", color="#0B3D91", label="Read the result and give thumbs up\nor down (optional)"];
start -> u1 [];
u1 -> s1 [];
s1 -> d1 [];
d1 -> s2 [label="Yes", ];
d1 -> o1 [label="No", ];
o1 -> u1 [label="upload again", constraint=false];
s2 -> u2 [];
u2 -> s3 [];
s3 -> d2 [];
d2 -> s4 [label="Yes", ];
d2 -> d3 [label="No", ];
s4 -> o4 [];
d3 -> o2 [label="Yes", ];
d3 -> s5 [label="No", ];
o2 -> end [];
s5 -> d4 [];
d4 -> a1 [label="No", ];
d4 -> s6 [label="Yes", ];
a1 -> s6 [];
s6 -> a2 [];
a2 -> d5 [];
d5 -> s7 [label="Yes", ];
d5 -> d6 [label="No", ];
d6 -> a2 [label="No: retry once", constraint=false];
d6 -> o3 [label="Yes", ];
o3 -> end [];
s7 -> o4 [];
o4 -> u3 [];
u3 -> end [];
}