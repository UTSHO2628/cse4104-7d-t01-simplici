digraph ER {
graph [rankdir=LR, nodesep=0.7, ranksep=1.6, pad=0.4, splines=polyline, fontname="Helvetica", labelloc=t, labeljust=l, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="LEFT"><FONT COLOR="#0B3D91" POINT-SIZE="22"><B>ER Diagram: SimpliCI (Week 04 system design)</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">7 tables, primary keys (PK), foreign keys (FK), unique keys (UQ). Crow's foot notation: bar = one, crow's foot = many, circle = optional. PostgreSQL on Supabase.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">Every parent to child relationship is ON DELETE CASCADE, so deleting a user or a document removes all of its pages, results, chats, feedback and share links.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">Constraints: unique (document_pages.document_id, page_number); unique share_links.token; feedback.rating is +1 or -1; feedback has exactly one of simplification_id or chat_message_id.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">Indexes: documents (user_id, created_at) for history; chat_messages (document_id, created_at); simplifications (document_id, language, reading_level, domain) for result caching; users.email.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">Enums: role (user, admin); language (bn, en); reading_level (beginner, university); domain (academic, medical, policy); source_type (pdf, image, text); status (uploaded, processing, ready, failed); verification_status (verified, unverified, not_found).</FONT></TD></TR></TABLE>>];
node [shape=plain, fontname="Helvetica", fontsize=9];
edge [fontname="Helvetica-Oblique", fontsize=9, color="#0B3D91", dir=both, arrowsize=0.9, labeldistance=1.4];
users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#0B3D91" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#0B3D91" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="12"><B>users</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#B45309" POINT-SIZE="8"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F3F6FB"><FONT COLOR="#1F2937" POINT-SIZE="8"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" PORT="name" BGCOLOR="#F3F6FB">name</TD><TD ALIGN="RIGHT" BGCOLOR="#F3F6FB"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#15803D" POINT-SIZE="8"><B>UQ</B></FONT></TD><TD ALIGN="LEFT" PORT="email">email</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F3F6FB"><FONT COLOR="#1F2937" POINT-SIZE="8"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" PORT="password_hash" BGCOLOR="#F3F6FB">password_hash</TD><TD ALIGN="RIGHT" BGCOLOR="#F3F6FB"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F2937" POINT-SIZE="8"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" PORT="role">role</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">enum</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F3F6FB"><FONT COLOR="#1F2937" POINT-SIZE="8"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" PORT="preferred_language" BGCOLOR="#F3F6FB">preferred_language</TD><TD ALIGN="RIGHT" BGCOLOR="#F3F6FB"><FONT COLOR="#6B7280" POINT-SIZE="8">enum</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F2937" POINT-SIZE="8"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" PORT="default_level">default_level</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">enum</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F3F6FB"><FONT COLOR="#1F2937" POINT-SIZE="8"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" PORT="is_active" BGCOLOR="#F3F6FB">is_active</TD><TD ALIGN="RIGHT" BGCOLOR="#F3F6FB"><FONT COLOR="#6B7280" POINT-SIZE="8">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F2937" POINT-SIZE="8"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">timestamp</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F3F6FB"><FONT COLOR="#1F2937" POINT-SIZE="8"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" PORT="last_login_at" BGCOLOR="#F3F6FB">last_login_at</TD><TD ALIGN="RIGHT" BGCOLOR="#F3F6FB"><FONT COLOR="#6B7280" POINT-SIZE="8">timestamp</FONT></TD></TR></TABLE>>];
documents [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#0B3D91" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#0B3D91" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="12"><B>documents</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#B45309" POINT-SIZE="8"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F3F6FB"><FONT COLOR="#0B3D91" POINT-SIZE="8"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="user_id" BGCOLOR="#F3F6FB">user_id</TD><TD ALIGN="RIGHT" BGCOLOR="#F3F6FB"><FONT COLOR="#6B7280" POINT-SIZE="8">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F2937" POINT-SIZE="8"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" PORT="title">title</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F3F6FB"><FONT COLOR="#1F2937" POINT-SIZE="8"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" PORT="source_type" BGCOLOR="#F3F6FB">source_type</TD><TD ALIGN="RIGHT" BGCOLOR="#F3F6FB"><FONT COLOR="#6B7280" POINT-SIZE="8">enum</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F2937" POINT-SIZE="8"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" PORT="domain">domain</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">enum</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F3F6FB"><FONT COLOR="#1F2937" POINT-SIZE="8"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" PORT="original_filename" BGCOLOR="#F3F6FB">original_filename</TD><TD ALIGN="RIGHT" BGCOLOR="#F3F6FB"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F2937" POINT-SIZE="8"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" PORT="storage_path">storage_path</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F3F6FB"><FONT COLOR="#1F2937" POINT-SIZE="8"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" PORT="page_count" BGCOLOR="#F3F6FB">page_count</TD><TD ALIGN="RIGHT" BGCOLOR="#F3F6FB"><FONT COLOR="#6B7280" POINT-SIZE="8">int</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F2937" POINT-SIZE="8"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" PORT="status">status</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">enum</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F3F6FB"><FONT COLOR="#1F2937" POINT-SIZE="8"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" PORT="created_at" BGCOLOR="#F3F6FB">created_at</TD><TD ALIGN="RIGHT" BGCOLOR="#F3F6FB"><FONT COLOR="#6B7280" POINT-SIZE="8">timestamp</FONT></TD></TR></TABLE>>];
document_pages [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#0B3D91" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#0B3D91" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="12"><B>document_pages</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#B45309" POINT-SIZE="8"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F3F6FB"><FONT COLOR="#0B3D91" POINT-SIZE="8"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="document_id" BGCOLOR="#F3F6FB">document_id</TD><TD ALIGN="RIGHT" BGCOLOR="#F3F6FB"><FONT COLOR="#6B7280" POINT-SIZE="8">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F2937" POINT-SIZE="8"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" PORT="page_number">page_number</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">int</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F3F6FB"><FONT COLOR="#1F2937" POINT-SIZE="8"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" PORT="text_content" BGCOLOR="#F3F6FB">text_content</TD><TD ALIGN="RIGHT" BGCOLOR="#F3F6FB"><FONT COLOR="#6B7280" POINT-SIZE="8">text</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F2937" POINT-SIZE="8"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" PORT="extraction_method">extraction_method</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">enum</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F3F6FB"><FONT COLOR="#1F2937" POINT-SIZE="8"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" PORT="created_at" BGCOLOR="#F3F6FB">created_at</TD><TD ALIGN="RIGHT" BGCOLOR="#F3F6FB"><FONT COLOR="#6B7280" POINT-SIZE="8">timestamp</FONT></TD></TR></TABLE>>];
simplifications [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#0B3D91" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#0B3D91" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="12"><B>simplifications</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#B45309" POINT-SIZE="8"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F3F6FB"><FONT COLOR="#0B3D91" POINT-SIZE="8"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="document_id" BGCOLOR="#F3F6FB">document_id</TD><TD ALIGN="RIGHT" BGCOLOR="#F3F6FB"><FONT COLOR="#6B7280" POINT-SIZE="8">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F2937" POINT-SIZE="8"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" PORT="language">language</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">enum</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F3F6FB"><FONT COLOR="#1F2937" POINT-SIZE="8"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" PORT="reading_level" BGCOLOR="#F3F6FB">reading_level</TD><TD ALIGN="RIGHT" BGCOLOR="#F3F6FB"><FONT COLOR="#6B7280" POINT-SIZE="8">enum</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F2937" POINT-SIZE="8"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" PORT="domain">domain</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">enum</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F3F6FB"><FONT COLOR="#1F2937" POINT-SIZE="8"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" PORT="summary" BGCOLOR="#F3F6FB">summary</TD><TD ALIGN="RIGHT" BGCOLOR="#F3F6FB"><FONT COLOR="#6B7280" POINT-SIZE="8">text</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F2937" POINT-SIZE="8"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" PORT="explanation">explanation</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">text</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F3F6FB"><FONT COLOR="#1F2937" POINT-SIZE="8"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" PORT="glossary" BGCOLOR="#F3F6FB">glossary</TD><TD ALIGN="RIGHT" BGCOLOR="#F3F6FB"><FONT COLOR="#6B7280" POINT-SIZE="8">jsonb</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F2937" POINT-SIZE="8"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" PORT="action_items">action_items</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">jsonb</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F3F6FB"><FONT COLOR="#1F2937" POINT-SIZE="8"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" PORT="alerts" BGCOLOR="#F3F6FB">alerts</TD><TD ALIGN="RIGHT" BGCOLOR="#F3F6FB"><FONT COLOR="#6B7280" POINT-SIZE="8">jsonb</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F2937" POINT-SIZE="8"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" PORT="model_name">model_name</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F3F6FB"><FONT COLOR="#1F2937" POINT-SIZE="8"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" PORT="prompt_version" BGCOLOR="#F3F6FB">prompt_version</TD><TD ALIGN="RIGHT" BGCOLOR="#F3F6FB"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F2937" POINT-SIZE="8"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" PORT="input_tokens">input_tokens</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">int</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F3F6FB"><FONT COLOR="#1F2937" POINT-SIZE="8"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" PORT="output_tokens" BGCOLOR="#F3F6FB">output_tokens</TD><TD ALIGN="RIGHT" BGCOLOR="#F3F6FB"><FONT COLOR="#6B7280" POINT-SIZE="8">int</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F2937" POINT-SIZE="8"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" PORT="response_ms">response_ms</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">int</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F3F6FB"><FONT COLOR="#1F2937" POINT-SIZE="8"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" PORT="status" BGCOLOR="#F3F6FB">status</TD><TD ALIGN="RIGHT" BGCOLOR="#F3F6FB"><FONT COLOR="#6B7280" POINT-SIZE="8">enum</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F2937" POINT-SIZE="8"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">timestamp</FONT></TD></TR></TABLE>>];
chat_messages [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#0B3D91" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#0B3D91" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="12"><B>chat_messages</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#B45309" POINT-SIZE="8"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F3F6FB"><FONT COLOR="#0B3D91" POINT-SIZE="8"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="document_id" BGCOLOR="#F3F6FB">document_id</TD><TD ALIGN="RIGHT" BGCOLOR="#F3F6FB"><FONT COLOR="#6B7280" POINT-SIZE="8">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0B3D91" POINT-SIZE="8"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="user_id">user_id</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F3F6FB"><FONT COLOR="#1F2937" POINT-SIZE="8"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" PORT="role" BGCOLOR="#F3F6FB">role</TD><TD ALIGN="RIGHT" BGCOLOR="#F3F6FB"><FONT COLOR="#6B7280" POINT-SIZE="8">enum</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F2937" POINT-SIZE="8"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" PORT="content">content</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">text</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F3F6FB"><FONT COLOR="#1F2937" POINT-SIZE="8"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" PORT="citations" BGCOLOR="#F3F6FB">citations</TD><TD ALIGN="RIGHT" BGCOLOR="#F3F6FB"><FONT COLOR="#6B7280" POINT-SIZE="8">jsonb</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F2937" POINT-SIZE="8"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" PORT="evidence_quote">evidence_quote</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">text</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F3F6FB"><FONT COLOR="#1F2937" POINT-SIZE="8"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" PORT="verification_status" BGCOLOR="#F3F6FB">verification_status</TD><TD ALIGN="RIGHT" BGCOLOR="#F3F6FB"><FONT COLOR="#6B7280" POINT-SIZE="8">enum</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F2937" POINT-SIZE="8"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" PORT="model_name">model_name</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F3F6FB"><FONT COLOR="#1F2937" POINT-SIZE="8"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" PORT="prompt_version" BGCOLOR="#F3F6FB">prompt_version</TD><TD ALIGN="RIGHT" BGCOLOR="#F3F6FB"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F2937" POINT-SIZE="8"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" PORT="tokens_used">tokens_used</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">int</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F3F6FB"><FONT COLOR="#1F2937" POINT-SIZE="8"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" PORT="response_ms" BGCOLOR="#F3F6FB">response_ms</TD><TD ALIGN="RIGHT" BGCOLOR="#F3F6FB"><FONT COLOR="#6B7280" POINT-SIZE="8">int</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F2937" POINT-SIZE="8"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">timestamp</FONT></TD></TR></TABLE>>];
feedback [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#0B3D91" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#0B3D91" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="12"><B>feedback</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#B45309" POINT-SIZE="8"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F3F6FB"><FONT COLOR="#0B3D91" POINT-SIZE="8"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="user_id" BGCOLOR="#F3F6FB">user_id</TD><TD ALIGN="RIGHT" BGCOLOR="#F3F6FB"><FONT COLOR="#6B7280" POINT-SIZE="8">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0B3D91" POINT-SIZE="8"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="simplification_id">simplification_id</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">uuid, null</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F3F6FB"><FONT COLOR="#0B3D91" POINT-SIZE="8"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="chat_message_id" BGCOLOR="#F3F6FB">chat_message_id</TD><TD ALIGN="RIGHT" BGCOLOR="#F3F6FB"><FONT COLOR="#6B7280" POINT-SIZE="8">uuid, null</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F2937" POINT-SIZE="8"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" PORT="rating">rating</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F3F6FB"><FONT COLOR="#1F2937" POINT-SIZE="8"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" PORT="comment" BGCOLOR="#F3F6FB">comment</TD><TD ALIGN="RIGHT" BGCOLOR="#F3F6FB"><FONT COLOR="#6B7280" POINT-SIZE="8">text</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F2937" POINT-SIZE="8"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">timestamp</FONT></TD></TR></TABLE>>];
share_links [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#0B3D91" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#0B3D91" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="12"><B>share_links</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#B45309" POINT-SIZE="8"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F3F6FB"><FONT COLOR="#0B3D91" POINT-SIZE="8"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="simplification_id" BGCOLOR="#F3F6FB">simplification_id</TD><TD ALIGN="RIGHT" BGCOLOR="#F3F6FB"><FONT COLOR="#6B7280" POINT-SIZE="8">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0B3D91" POINT-SIZE="8"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="created_by">created_by</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F3F6FB"><FONT COLOR="#15803D" POINT-SIZE="8"><B>UQ</B></FONT></TD><TD ALIGN="LEFT" PORT="token" BGCOLOR="#F3F6FB">token</TD><TD ALIGN="RIGHT" BGCOLOR="#F3F6FB"><FONT COLOR="#6B7280" POINT-SIZE="8">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F2937" POINT-SIZE="8"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" PORT="expires_at">expires_at</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">timestamp</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F3F6FB"><FONT COLOR="#1F2937" POINT-SIZE="8"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" PORT="is_revoked" BGCOLOR="#F3F6FB">is_revoked</TD><TD ALIGN="RIGHT" BGCOLOR="#F3F6FB"><FONT COLOR="#6B7280" POINT-SIZE="8">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F2937" POINT-SIZE="8"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="RIGHT"><FONT COLOR="#6B7280" POINT-SIZE="8">timestamp</FONT></TD></TR></TABLE>>];
users -> documents [xlabel="owns", arrowtail=teetee, arrowhead=crow];
documents -> document_pages [xlabel="has pages", arrowtail=teetee, arrowhead=crow];
documents -> simplifications [xlabel="has results", arrowtail=teetee, arrowhead=crow];
documents -> chat_messages [xlabel="has chat", arrowtail=teetee, arrowhead=crow];
users -> chat_messages [xlabel="asks", arrowtail=teetee, arrowhead=crow];
users -> feedback [xlabel="gives", arrowtail=teetee, arrowhead=crow];
simplifications -> feedback [xlabel="rated by", arrowtail=teeodot, arrowhead=crow];
chat_messages -> feedback [xlabel="rated by", arrowtail=teeodot, arrowhead=crow];
simplifications -> share_links [xlabel="shared as", arrowtail=teetee, arrowhead=crow];
users -> share_links [xlabel="creates", arrowtail=teetee, arrowhead=crow];
}