digraph A {
graph [rankdir=TB, nodesep=0.5, ranksep=0.42, pad=0.4, splines=true, fontname="Helvetica", labelloc=t, labeljust=l, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="LEFT"><FONT COLOR="#0B3D91" POINT-SIZE="20"><B>Activity Diagram 2: Chat with the Document (with evidence verification)</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="10">Workflow of grounded question answering (SRS UC-06, UC-20; API-18). The key step is the evidence check that separates SimpliCI from a plain chatbot.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">Legend: blue = user action, grey = system process, violet = AI service step, green = output shown to the user, yellow diamond = decision, black circle = start, double circle = end.</FONT></TD></TR></TABLE>>];
node [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", margin="0.16,0.08"];
edge [fontname="Helvetica-Oblique", fontsize=9, color="#374151", arrowsize=0.8];
start [shape=circle, label="", width=0.25, style=filled, fillcolor="#111827", color="#111827"];
end [shape=doublecircle, label="", width=0.22, style=filled, fillcolor="#111827", color="#111827"];
u1 [fillcolor="#E8F0FE", color="#0B3D91", label="Type a question about the document"];
s1 [fillcolor="#F3F4F6", color="#6B7280", label="Validate the question\n(not empty, at most 1,000 characters)"];
d1 [shape=diamond, style=filled, fillcolor="#FFF4D6", color="#B45309", label="Question\nvalid?", margin="0.04,0.02"];
o1 [fillcolor="#E7F6EC", color="#15803D", label="Show a validation message"];
s2 [fillcolor="#F3F4F6", color="#6B7280", label="Check the AI rate limit"];
d2 [shape=diamond, style=filled, fillcolor="#FFF4D6", color="#B45309", label="Rate limit\nreached?", margin="0.04,0.02"];
o2 [fillcolor="#E7F6EC", color="#15803D", label="Show 'try again later' message (429)"];
s3 [fillcolor="#F3F4F6", color="#6B7280", label="Select the most relevant pages of the document"];
a1 [fillcolor="#EDE9FE", color="#6D28D9", label="Gemini answers only from these pages\nand returns an evidence quote (JSON)"];
d3 [shape=diamond, style=filled, fillcolor="#FFF4D6", color="#B45309", label="AI call\nsucceeded and JSON valid?", margin="0.04,0.02"];
o3 [fillcolor="#E7F6EC", color="#15803D", label="Show a friendly error (502)"];
d4 [shape=diamond, style=filled, fillcolor="#FFF4D6", color="#B45309", label="Answer found\nin the document?", margin="0.04,0.02"];
s4 [fillcolor="#F3F4F6", color="#6B7280", label="Set status not_found\n(answer says it was not found)"];
s5 [fillcolor="#F3F4F6", color="#6B7280", label="Check that the evidence quote exists\non the cited page"];
d5 [shape=diamond, style=filled, fillcolor="#FFF4D6", color="#B45309", label="Quote\nfound?", margin="0.04,0.02"];
s6 [fillcolor="#F3F4F6", color="#6B7280", label="Mark the answer as verified"];
s7 [fillcolor="#F3F4F6", color="#6B7280", label="Mark the answer as unverified"];
s8 [fillcolor="#F3F4F6", color="#6B7280", label="Save the question and the answer\nin the chat history"];
o4 [fillcolor="#E7F6EC", color="#15803D", label="Show the answer with page citations and a\nverified badge or a warning (or the not-found message)"];
u2 [fillcolor="#E8F0FE", color="#0B3D91", label="Give thumbs up or down (optional)"];
start -> u1 [];
u1 -> s1 [];
s1 -> d1 [];
d1 -> s2 [label="Yes", ];
d1 -> o1 [label="No", ];
o1 -> u1 [label="ask again", constraint=false];
s2 -> d2 [];
d2 -> o2 [label="Yes", ];
d2 -> s3 [label="No", ];
o2 -> end [];
s3 -> a1 [];
a1 -> d3 [];
d3 -> o3 [label="No", ];
d3 -> d4 [label="Yes", ];
o3 -> end [];
d4 -> s4 [label="No", ];
d4 -> s5 [label="Yes", ];
s5 -> d5 [];
d5 -> s6 [label="Yes", ];
d5 -> s7 [label="No", ];
s6 -> s8 [];
s7 -> s8 [];
s4 -> s8 [];
s8 -> o4 [];
o4 -> u2 [];
u2 -> end [];
}