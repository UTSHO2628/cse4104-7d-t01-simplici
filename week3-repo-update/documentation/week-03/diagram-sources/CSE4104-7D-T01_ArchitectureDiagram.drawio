<mxfile host="app.diagrams.net"><diagram name="Architecture" id="d1"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="860" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Initial System Architecture Diagram: SimpliCI" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#0B3D91;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="700" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Frontend, backend, database and AI services with hosting platforms. Frontend &gt; Backend API &gt; Database, with the backend calling the AI service." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="30" y="44" width="900" height="20" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;End users&lt;/b&gt;&lt;br&gt;Guest, User and Admin in a web browser" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontColor=#1F2937;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="250" height="46" as="geometry"/></mxCell><mxCell id="c6" value="Frontend hosted on Vercel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6B7280;fontColor=#1F2937;dashed=1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="30" y="150" width="250" height="520" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;React SPA (Vite)&lt;/b&gt;&lt;br&gt;Pages: auth, dashboard, upload, result, chat, history, admin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#0B3D91;fontColor=#1F2937;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="185" width="210" height="86" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;UI layer&lt;/b&gt;&lt;br&gt;Tailwind CSS, react-pdf split-view reader, Recharts admin charts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#0B3D91;fontColor=#1F2937;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="295" width="210" height="86" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;API client and auth store&lt;/b&gt;&lt;br&gt;Axios or fetch, JWT in memory or secure storage, route guards" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#0B3D91;fontColor=#1F2937;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="405" width="210" height="86" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Browser speech synthesis&lt;/b&gt;&lt;br&gt;Read aloud (Bangla and English)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontColor=#1F2937;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="515" width="210" height="70" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;PDF export and share view&lt;/b&gt;&lt;br&gt;Download result, read-only shared page" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontColor=#1F2937;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="600" width="210" height="55" as="geometry"/></mxCell><mxCell id="c12" value="Backend hosted on Render: Node.js + Express REST API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6B7280;fontColor=#1F2937;dashed=1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="340" y="100" width="440" height="700" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Security middleware&lt;/b&gt;&lt;br&gt;Helmet, CORS, rate limiting, Zod validation, JWT check and role guard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#0B3D91;fontColor=#1F2937;fontSize=11;" vertex="1" parent="1"><mxGeometry x="360" y="130" width="400" height="60" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Auth module&lt;/b&gt;&lt;br&gt;Register, login, JWT, bcrypt, roles" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#0B3D91;fontColor=#1F2937;fontSize=11;" vertex="1" parent="1"><mxGeometry x="360" y="215" width="190" height="78" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Document module&lt;/b&gt;&lt;br&gt;Upload (Multer), type and size checks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#0B3D91;fontColor=#1F2937;fontSize=11;" vertex="1" parent="1"><mxGeometry x="570" y="215" width="190" height="78" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Extraction service&lt;/b&gt;&lt;br&gt;Page-wise text (pdf-parse or pdfjs), vision for scans" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#0B3D91;fontColor=#1F2937;fontSize=11;" vertex="1" parent="1"><mxGeometry x="360" y="313" width="190" height="78" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Simplification service&lt;/b&gt;&lt;br&gt;Prompt builder, domain presets, JSON schema check" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#0B3D91;fontColor=#1F2937;fontSize=11;" vertex="1" parent="1"><mxGeometry x="570" y="313" width="190" height="78" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Chat service&lt;/b&gt;&lt;br&gt;Grounded Q and A with page citations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#0B3D91;fontColor=#1F2937;fontSize=11;" vertex="1" parent="1"><mxGeometry x="360" y="411" width="190" height="78" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Evidence verifier&lt;/b&gt;&lt;br&gt;Quoted evidence must exist on the cited page" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#B45309;fontColor=#1F2937;fontSize=11;" vertex="1" parent="1"><mxGeometry x="570" y="411" width="190" height="78" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Share and export service&lt;/b&gt;&lt;br&gt;PDF export, expiring share links" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#0B3D91;fontColor=#1F2937;fontSize=11;" vertex="1" parent="1"><mxGeometry x="360" y="509" width="190" height="78" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Feedback service&lt;/b&gt;&lt;br&gt;Thumbs up or down, comments" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#0B3D91;fontColor=#1F2937;fontSize=11;" vertex="1" parent="1"><mxGeometry x="570" y="509" width="190" height="78" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Admin and analytics service&lt;/b&gt;&lt;br&gt;Usage, feedback rate, failed checks, tokens" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F6EC;strokeColor=#15803D;fontColor=#1F2937;fontSize=11;" vertex="1" parent="1"><mxGeometry x="360" y="607" width="190" height="78" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Gemini client&lt;/b&gt;&lt;br&gt;Model from GEMINI_MODEL, retries, token and time logging" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#0B3D91;fontColor=#1F2937;fontSize=11;" vertex="1" parent="1"><mxGeometry x="570" y="607" width="190" height="78" as="geometry"/></mxCell><mxCell id="c24" value="Data access layer (pg and Supabase client)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#0B3D91;fontColor=#1F2937;fontSize=11;" vertex="1" parent="1"><mxGeometry x="360" y="715" width="400" height="58" as="geometry"/></mxCell><mxCell id="c25" value="Supabase (database and file storage)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6B7280;fontColor=#1F2937;dashed=1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="830" y="100" width="330" height="340" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;PostgreSQL database&lt;/b&gt;&lt;br&gt;users, documents, document_pages, simplifications, chat_messages, feedback, share_links" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#0B3D91;fontColor=